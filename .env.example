# Optional: blank values use the documented development defaults.
NODE_ENV=
HOST=
PORT=
LOG_LEVEL=
# Optional Vite process environment override for a custom backend address.
API_PROXY_TARGET=
# PostgreSQL connection URL, used by migrations and enabled authentication.
DATABASE_URL=
# Separate PostgreSQL test database; tests use a temporary isolated schema.
TEST_DATABASE_URL=
# Set true to enable Spotify OAuth after configuring the database and encryption.
SPOTIFY_AUTH_ENABLED=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
# Optional alias for managed environment configuration.
SPOTIFY_REDIRECT_URL=
# Browser origin; defaults to the redirect URI origin.
APP_ORIGIN=
# Secret JSON object mapping key IDs to base64-encoded 32-byte keys.
# Local development: npm run auth:keygen creates an ignored key file.
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_KEY_ID=
